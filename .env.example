# Oracle Database Configuration
ORACLE_USER=admin
ORACLE_PASSWORD=YourStrongOraclePassword123
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1

# Optional full connect string (if used, overrides host/port/service_name)
# ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# Application Settings
FLASK_PORT=5001
FLASK_DEBUG=True
SECRET_KEY=divine-blessings-secret-key-2026

# Fallback Settings:
# If set to true, automatically runs in SQLite mock mode if Oracle DB is unreachable,
# allowing full UI and API testing out-of-the-box.
AUTO_FALLBACK_SQLITE=true
